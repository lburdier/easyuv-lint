{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyUV Lint",
  "version": "0.2.0",
  "identifier": "fr.lburdier.easyuvlint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EasyUV Lint",
        "width": 1380,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0d0d0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lucas Burdier",
    "copyright": "Lucas Burdier · GPL-3.0-or-later",
    "category": "DeveloperTool",
    "shortDescription": "Check 3D assets: UV overlaps, texel density, polycount, scale",
    "homepage": "https://lburdier.github.io/easyuv-lint/",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
